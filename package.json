{
  "name": "politicamais",
  "version": "0.2.0",
  "private": false,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run icons && npm run check && npm run data:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run types && npm run test",
    "check": "tsx scripts/checkContent.ts",
    "icons": "tsx scripts/icons.ts",
    "data:fetch": "tsx scripts/fetchData.ts",
    "data:build": "tsx scripts/buildData.ts",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android && npm run icons",
    "android:open": "cap open android"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "marked": "^16.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.11",
    "zod": "^4.1.5"
  },
  "overrides": {
    "vitest": "4.1.11"
  },
  "description": "Dados oficiais sobre política brasileira em tempo real: votações da Câmara, fichas de parlamentares, indicadores do Banco Central e verificação de afirmações.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonuffykk/politicamais.git"
  },
  "homepage": "https://politicamais.com",
  "bugs": {
    "url": "https://github.com/jonuffykk/politicamais/issues"
  },
  "keywords": [
    "brasil",
    "politica",
    "dados-abertos",
    "camara-dos-deputados",
    "banco-central",
    "transparencia",
    "next.js",
    "capacitor"
  ]
}
